{
  "name": "@retailer-search/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./security-headers": {
      "types": "./dist/security-headers.d.ts",
      "default": "./dist/security-headers.js"
    },
    "./safe-text": {
      "types": "./dist/safe-text.d.ts",
      "default": "./dist/safe-text.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --noEmit",
    "lint": "echo \"lint pending\"",
    "test": "tsx --test src/security-headers.test.ts src/safe-text.test.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
