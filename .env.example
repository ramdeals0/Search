SEARCH_API_PORT=4001
SEARCH_API_HOST=0.0.0.0
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:4001

# Database — PostgreSQL (Railway recommended) or SQLite (offline local only)
#
# Railway PostgreSQL (public proxy for local dev; use plugin reference on Railway):
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"
#
# SQLite example (legacy local; schema in repo targets PostgreSQL):
# DATABASE_URL="file:./prisma/dev.db"
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"

# Session lifetime for auth tokens (hours)
SESSION_TTL_HOURS=8

# End sessions after this many minutes without authenticated API activity
SESSION_INACTIVITY_MINUTES=30

# Show inactivity warning this many minutes before timeout in the admin UI
SESSION_WARNING_MINUTES=5

# CSRF token signing secret for session-authenticated admin mutations
CSRF_SECRET=change-me-in-production

# Runtime mode and API hardening
NODE_ENV=development
ENFORCE_HTTPS=false

# Browser security headers (HSTS is sent when NODE_ENV=production or ENFORCE_HTTPS=true)

# First-run setup (set ALLOW_SETUP=false to disable the setup wizard)
APP_NAME=Retail Discovery Platform
ALLOW_SETUP=true

# Rate limiting (in-memory, per-process)
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_LOGIN_IP_LIMIT=30
RATE_LIMIT_AUTH_LOGIN_IP_WINDOW_SECONDS=300

# Account lockout after repeated failed logins (also configurable in setup wizard)
AUTH_LOGIN_ATTEMPT_LIMIT=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_MAX_LOCKOUT_MINUTES=1440
RATE_LIMIT_ADMIN_MUTATION_LIMIT=60
RATE_LIMIT_ADMIN_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_READ_LIMIT=300
RATE_LIMIT_ADMIN_READ_WINDOW_SECONDS=60

# Railway sets PORT automatically and the API binds to PORT when it is present.
# Do not set SEARCH_API_PORT on Railway unless you know you need a fixed local port.
#
# Required on admin Railway service (runtime, no rebuild needed for URL changes):
# SEARCH_API_URL=https://search-api-production.up.railway.app
#
# Required on storefront Railway service (must be set before build):
# NEXT_PUBLIC_SEARCH_API_URL=https://search-api-production.up.railway.app
#
# When SEARCH_API_KEY_REQUIRED=true on search-api, set on each storefront service:
# SEARCH_API_KEY=your-storefront-api-key

# Catalog scale (supports up to 80M products in database-backed mode)
# On Railway, defaults to 25,000 in-memory / 1,500 DB candidates unless overridden.
CATALOG_IN_MEMORY_THRESHOLD=100000
EMBEDDING_IN_MEMORY_THRESHOLD=5000
CATALOG_SEARCH_CANDIDATE_LIMIT=5000
CATALOG_DB_BATCH_SIZE=1000
CATALOG_VECTOR_SEARCH_LIMIT=500
CATALOG_SEED_BATCH_SIZE=2000
# TARGET_PRODUCT_COUNT=50000
HYBRID_SEARCH_ENABLED=false
VECTOR_SEARCH_ENABLED=false
SEMANTIC_SEARCH_ENABLED=false
PERSONALIZATION_ENABLED=true
SEMANTIC_ZERO_RESULTS_FALLBACK_ENABLED=true
SEMANTIC_FALLBACK_MIN_HITS=3
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=mock-hash-v1
EMBEDDING_DIMENSIONS=64
EMBEDDINGS_BATCH_SIZE=32
EMBEDDING_BATCH_SIZE=32
EMBEDDINGS_MAX_RETRIES=3
EMBEDDINGS_CONCURRENCY=1
PRODUCT_EMBEDDINGS_ENABLED=true
# EMBEDDINGS_API_KEY=

# pgvector storage + ANN tuning
PGVECTOR_ENABLED=true
VECTOR_DISTANCE_METRIC=cosine
VECTOR_INDEX_TYPE=hnsw
VECTOR_INDEX_LISTS=100
VECTOR_QUERY_PROBES=10
VECTOR_QUERY_EF_SEARCH=40

# Embedding worker (separate Railway service)
EMBEDDING_WORKER_ENABLED=false
EMBEDDING_WORKER_POLL_MS=2000
EMBEDDING_BACKFILL_CRON_ENABLED=false
EMBEDDING_JOB_LOCK_TIMEOUT_MS=300000

# Unified hybrid + rerank pipeline
RERANK_ENABLED=false
RERANK_PROVIDER=score_fusion
RERANK_TOP_N=50
RERANK_TIMEOUT_MS=500
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
LEXICAL_WEIGHT=0.55
SEMANTIC_WEIGHT=0.30
PERSONALIZATION_WEIGHT=0.15
PERSONALIZATION_LOOKBACK_DAYS=30
PERSONALIZATION_DECAY_HALF_LIFE_DAYS=14
